FROM golang:1.26.5 AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/csms-operator ./cmd/operator

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/csms-operator /csms-operator
EXPOSE 8080 8081
USER nonroot:nonroot
ENTRYPOINT ["/csms-operator"]
